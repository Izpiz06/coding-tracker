generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Platform {
  LEETCODE
  CODEFORCES
}

enum RoomRole {
  OWNER
  MEMBER
}

enum PeriodMode {
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id               Int            @id @default(autoincrement())
  name             String
  email            String?        @unique
  passwordHash     String?
  githubHandle     String?
  leetcodeHandle   String?        @unique
  codeforcesHandle String?        @unique
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  snapshots        StatSnapshot[]
  submissions      Submission[]

  rooms            RoomMember[]
  createdRooms     Room[]           @relation("RoomCreator")
  roomActivities   RoomActivity[]
  sessions         Session[]

  friendshipsSent     Friendship[] @relation("FriendshipsSent")
  friendshipsReceived Friendship[] @relation("FriendshipsReceived")
}

model StatSnapshot {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  platform        Platform
  
  easySolved      Int?
  mediumSolved    Int?
  hardSolved      Int?
  
  totalSolved     Int
  
  rating          Int?     
  maxRating       Int?     
  rank            String?  
  
  recordedAt      DateTime @default(now())

  @@index([userId, platform])
}

model Submission {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  platform    Platform
  problemId   String   
  problemName String   
  language    String?  
  tags        String[] 
  
  runtime     Float?
  memory      Float?
  
  solvedAt    DateTime @default(now())

  @@unique([userId, platform, problemId])
  @@index([userId, platform])
}

model Room {
  id          Int            @id @default(autoincrement())
  name        String
  joinCode    String         @unique @db.VarChar(6)
  roomPasscode String?       @db.VarChar(120)
  createdById Int
  createdBy   User           @relation("RoomCreator", fields: [createdById], references: [id])

  periodMode  PeriodMode     @default(WEEKLY)
  periodStart DateTime       @default(now())

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  members     RoomMember[]
  activities  RoomActivity[]
}

model RoomMember {
  id       Int      @id @default(autoincrement())
  roomId   Int
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     RoomRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

model RoomActivity {
  id        Int      @id @default(autoincrement())
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  message   String
  scoreGain Int      @default(0)
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Friendship {
  id         Int              @id @default(autoincrement())
  senderId   Int
  sender     User             @relation("FriendshipsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId Int
  receiver   User             @relation("FriendshipsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}